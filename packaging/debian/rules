#!/usr/bin/make -f
# -*- makefile -*-
# Debhelper rules for marinaMoji.
#
# Build path:
#   1. Prefer Bazel vendor mode when a vendor tree exists (#53 / DFSG.md):
#      top-level vendor/ (additional orig tarball), else debian/vendor,
#      else debian/vendor-linux.
#   2. Otherwise fall back to a networked Bazel build (maintainer laptop).
#
# Shared branding/metadata comes from packaging/linux/.

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

BAZEL ?= $(shell command -v bazelisk 2>/dev/null || command -v bazel)

PRODUCT_VERSION := $(shell cat src/marina_product_version.txt)
LINUX_PACKAGING := packaging/linux

# Resolve vendor directory for offline builds.
VENDOR_DIR :=
ifneq ($(wildcard $(CURDIR)/vendor),)
VENDOR_DIR := $(CURDIR)/vendor
else ifneq ($(wildcard $(CURDIR)/debian/vendor),)
VENDOR_DIR := $(CURDIR)/debian/vendor
else ifneq ($(wildcard $(CURDIR)/debian/vendor-linux),)
VENDOR_DIR := $(CURDIR)/debian/vendor-linux
endif

BAZEL_OFFLINE_FLAGS :=
ifneq ($(VENDOR_DIR),)
BAZEL_OFFLINE_FLAGS := \
	--vendor_dir=$(VENDOR_DIR) \
	--repository_disable_download \
	--lockfile_mode=error
endif

%:
	dh $@

# The vendor tree contains no autotools-managed project of ours; do not let
# debhelper rewrite files inside it (it would also dirty the source tree).
override_dh_update_autotools_config:
override_dh_autoreconf:

override_dh_auto_configure:
	@if [ -z "$(BAZEL)" ]; then \
		echo "debian/rules: need bazelisk or bazel in PATH" >&2; \
		exit 1; \
	fi
	@echo "debian/rules: using $$(command -v $(BAZEL) || echo $(BAZEL))"
	@if [ -n "$(VENDOR_DIR)" ] && [ ! -f src/MODULE.bazel.lock ] \
		&& [ -f "$(VENDOR_DIR)/MODULE.bazel.lock" ]; then \
		echo "debian/rules: installing src/MODULE.bazel.lock from the vendor tree"; \
		cp "$(VENDOR_DIR)/MODULE.bazel.lock" src/MODULE.bazel.lock; \
	fi
	@if [ -n "$(BAZEL_OFFLINE_FLAGS)" ]; then \
		echo "debian/rules: offline mode via $(VENDOR_DIR)"; \
	else \
		echo "debian/rules: WARNING: no vendor tree; Bazel may use the network."; \
		echo "debian/rules: See packaging/debian/DFSG.md and offline/vendor_deps.sh."; \
	fi

override_dh_auto_build:
	cd src && $(BAZEL) build package \
		--config oss_linux \
		--config release_build \
		--define CHANNEL=stable \
		$(BAZEL_OFFLINE_FLAGS)

override_dh_auto_test:
	@true

override_dh_auto_install:
	install -d debian/marinamoji
	unzip -q src/bazel-bin/unix/mozc.zip -d debian/marinamoji
	rm -rf debian/marinamoji/tmp
	bash $(LINUX_PACKAGING)/install_desktop_metadata.sh \
		--root debian/marinamoji \
		--version $(PRODUCT_VERSION) \
		--data-dir $(LINUX_PACKAGING)/data
	install -d debian/marinamoji/usr/share/man/man1
	gzip -9n < $(LINUX_PACKAGING)/data/mozc_emacs_helper.1 \
		> debian/marinamoji/usr/share/man/man1/mozc_emacs_helper.1.gz
	for bin in \
		usr/lib/marinamoji/mozc_server \
		usr/lib/marinamoji/mozc_tool \
		usr/lib/marinamoji/mozc_renderer \
		usr/lib/marinamoji/mozc_sync \
		usr/lib/ibus-marinamoji/ibus-engine-marinamoji \
		usr/bin/mozc_emacs_helper; do \
		chmod 755 debian/marinamoji/$$bin; \
	done

override_dh_auto_clean:
	dh_auto_clean
