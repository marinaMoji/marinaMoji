# uscan configuration (watch file format version 4).
# Tracks GitHub release tags; mangling maps SemVer -rcN to Debian ~rcN and
# appends +ds1 for the Files-Excluded repack (see DFSG.md).
version=4
opts="filenamemangle=s%.*/v?@ANY_VERSION@%@PACKAGE@-$1.tar.gz%,\
      uversionmangle=s/-rc/~rc/;s/$$/+ds1/, \
      dversionmangle=s/\+ds\d+$$//" \
  https://github.com/marinaMoji/marinaMoji/tags \
  .*/refs/tags/v?@ANY_VERSION@
