## Startup options
startup  --windows_enable_symlinks  # ignored on non-Windows platforms

## Xcode discovery runs during repo mapping (before --config oss_macos).
## Without DEVELOPER_DIR here, bazel clean --expunge can leave a broken
## local_config_xcode that breaks all macOS builds.
common --repo_env=DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer

## If target platform is not specified, linux, macos, or windows will be used
## considering the host platform.
common --enable_platform_specific_config

## Compiler options
## Define these before the platform env configs that reference them.
# Make sure we set -std=c++20 that may affect ABI across all the compilation targets.
# https://github.com/abseil/abseil-cpp/blob/master/FAQ.md#what-is-abi-and-why-dont-you-recommend-using-a-pre-compiled-version-of-abseil
build:compiler_gcc_like --cxxopt "-std=c++20" --host_cxxopt "-std=c++20"
build:compiler_gcc_like --copt "-funsigned-char" --host_copt "-funsigned-char"
build:compiler_gcc_like --copt "-Wno-sign-compare" --host_copt "-Wno-sign-compare"
build:compiler_gcc_like --copt "-Wno-char-subscripts" --host_copt "-Wno-char-subscripts"
build:compiler_msvc_like --cxxopt "/std:c++20" --host_cxxopt "/std:c++20"
build:compiler_msvc_like --cxxopt "/Zc:__cplusplus" --host_cxxopt "/Zc:__cplusplus"
build:compiler_msvc_like --copt "/J" --host_copt "/J"
build:compiler_msvc_like --copt "/utf-8" --host_copt "/utf-8"
build:compiler_msvc_like --cxxopt "/J" --host_cxxopt "/J"
build:compiler_msvc_like --cxxopt "/utf-8" --host_cxxopt "/utf-8"
# Disable all warnings for external code.
build:compiler_gcc_like  --per_file_copt="external/.*@-w" --host_per_file_copt="external/.*@-w"
build:compiler_msvc_like --per_file_copt="external/.*@/w" --host_per_file_copt="external/.*@/w"
# libsodium's runtime-dispatched x86 SIMD implementations (aesni/ssse3/sse41/
# avx2/avx512f, picked at runtime via CPUID) are gated behind HAVE_AVXINTRIN_H
# / HAVE_WMMINTRIN_H, which libsodium's own configure script normally sets in
# its generated config.h. The Bazel Central Registry's BUILD.bazel bypasses
# autoconf (local_defines = ["CONFIGURED"]), so those HAVE_* macros are never
# defined on GCC/Clang and every one of these files preprocesses to an empty
# translation unit regardless of target CPU or compiler flags — libsodium
# always falls back to its portable C reference implementations here. Do not
# add per-file `-msse2`/`-mavx`/etc. flags for these files: they change
# nothing on x86_64 (the code they'd enable is compiled out) and break the
# build outright on arm64, where gcc rejects the x86-only flags.
# windows.yaml still passes --config x86_simd; keep the config defined (as a
# no-op) so Bazel doesn't reject the flag outright.
build:x86_simd --define=x86_simd_noop=true

## Target platforms
common:linux          --config=linux_env --define TARGET=oss_linux
common:oss_linux      --noenable_platform_specific_config --config=linux_env --define TARGET=oss_linux
common:prod_linux     --noenable_platform_specific_config --config=linux_env --define TARGET=prod_linux
common:prod_linux_dev --noenable_platform_specific_config --config=linux_env --define TARGET=prod_linux --config=dev_channel

common:macos          --config=macos_env --define TARGET=oss_macos
common:oss_macos      --noenable_platform_specific_config --config=macos_env --define TARGET=oss_macos
common:prod_macos     --noenable_platform_specific_config --config=macos_env --define TARGET=prod_macos
common:prod_macos_dev --noenable_platform_specific_config --config=macos_env --define TARGET=prod_macos --config=dev_channel

common:windows          --config=windows_env --define TARGET=oss_windows
common:oss_windows      --noenable_platform_specific_config --config=windows_env --define TARGET=oss_windows
common:prod_windows     --noenable_platform_specific_config --config=windows_env --define TARGET=prod_windows
common:prod_windows_dev --noenable_platform_specific_config --config=windows_env --define TARGET=prod_windows --config=dev_channel

common:android      --noenable_platform_specific_config --config=android_env --define TARGET=oss_android
common:oss_android  --noenable_platform_specific_config --config=android_env --define TARGET=oss_android
common:prod_android --noenable_platform_specific_config --config=android_env --define TARGET=prod_android

## Build channels
build:dev_channel    --define CHANNEL=dev
build:stable_channel --define CHANNEL=stable

## Release build
build:release_build --compilation_mode=opt
build:release_build --copt=-DABSL_MIN_LOG_LEVEL=100

## Clang-cl toolchain for Windows
build:windows_env --extra_toolchains=@local_config_cc//:cc-toolchain-arm64_windows-clang-cl
build:windows_env --extra_toolchains=@local_config_cc//:cc-toolchain-x64_windows-clang-cl
build:windows_env --extra_toolchains=@local_config_cc//:cc-toolchain-x64_x86_windows-clang-cl
build:windows_env --host_platform=//:host-windows-clang-cl
build:windows_env --repo_env=BAZEL_WIN32_WINNT=/D_WIN32_WINNT=0x0A00
build:windows_env --action_env=BAZEL_VC
# Without this, libsodium's export.h marks every public function
# __declspec(dllimport) (its Windows default assumes you're consuming a
# prebuilt sodium.dll), even though @libsodium//:libsodium is a plain
# cc_library we statically link in. That mismatch alone is usually harmless
# (LNK4217 warnings), but at libsodium's scale it appears to be what crashes
# lld-link during the final link. Defining this globally also covers our own
# code that includes <sodium.h> (sync/), not just libsodium's own sources.
build:windows_env --copt="-DSODIUM_STATIC" --host_copt="-DSODIUM_STATIC"

## Compiler options
common:linux_env   --config=compiler_gcc_like
common:android_env --config=compiler_gcc_like
common:macos_env   --config=compiler_gcc_like
common:windows_env --config=compiler_msvc_like

## Linux specific options
build:linux_env --build_tag_filters=-nolinux --copt "-fPIC"
test:linux_env   --test_tag_filters=-nolinux

## macOS specific options
build:macos_env --build_tag_filters=-nomac --objccopt "-fsigned-char"
build:macos_env --macos_minimum_os=12.0 --host_macos_minimum_os=12.0
# Let Bazel discover the Xcode/SDK installed on the runner or developer machine.
build:macos_env --repo_env=DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
build:macos_env --action_env=DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
# macOS 26+: xcode-locator fails inside Bazel's darwin sandbox without fix_bazel_xcode_config.sh
build:macos_env --spawn_strategy=local
test:macos_env   --test_tag_filters=-nomac

## Windows specific options
common:windows_env --enable_runfiles
build:windows_env --build_tag_filters=-nowin
test:windows_env   --test_tag_filters=-nowin

build:win_universal_installer --//:win_universal_installer

# Android specific options
build:android_env --copt "-DOS_ANDROID"
build:android_env --build_tag_filters=-noandroid
test:android_env  --test_tag_filters=-noandroid

## SFrame relocation errors workaround for GCC 15+ and LLD 19+
build:no_sframe --copt="-Wa,--gsframe=no" --host_copt="-Wa,--gsframe=no"
