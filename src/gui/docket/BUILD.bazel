load(
    "//bazel:qt.bzl",
    "mozc_cc_qt_binary",
    "mozc_cc_qt_library",
)

package(default_visibility = ["//gui:__subpackages__"])

# No .ui/.qrc/moc genrules: the table-plus-toolbar layout is small enough
# to build directly in C++ (see docket_dialog.h for why), and the class
# defines no signals/slots/properties of its own, so it needs no Q_OBJECT
# and therefore no moc step either.
mozc_cc_qt_library(
    name = "docket_dialog",
    srcs = [
        "docket_dialog.cc",
        "docket_dialog_libmain.cc",
    ],
    hdrs = ["docket_dialog.h"],
    deps = [
        "//client",
        "//data_manager:pos_list_provider",
        "//dictionary:docket_store",
        "//dictionary:pos_matcher",
        "//dictionary:user_dictionary_storage",
        "//dictionary:user_dictionary_util",
        "//dictionary:user_pos",
        "//gui/base:gui_base",
        "//gui/base:singleton_window_helper",
        "//protocol:user_dictionary_storage_cc_proto",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

mozc_cc_qt_library(
    name = "docket_dialog_main_lib",
    srcs = ["docket_dialog_main.cc"],
    deps = [
        ":docket_dialog",
        "//base:init_mozc",
        "//gui/base:gui_base",
    ],
)

mozc_cc_qt_binary(
    name = "docket_dialog_main",
    deps = [":docket_dialog_main_lib"],
)
