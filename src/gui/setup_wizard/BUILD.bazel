load(
    "//:build_defs.bzl",
    "mozc_objc_library",
    "mozc_select",
)
load(
    "//bazel:qt.bzl",
    "mozc_cc_qt_binary",
    "mozc_cc_qt_library",
    "mozc_macos_qt_application",
    "mozc_qt_moc",
    "mozc_qt_rcc",
)

package(default_visibility = ["//gui:__subpackages__"])

mozc_qt_moc(
    name = "moc_setup_wizard",
    srcs = ["setup_wizard.h"],
    outs = ["moc_setup_wizard.cc"],
)

mozc_qt_rcc(
    name = "qrc_setup_wizard",
    srcs = [
        "harbour_splash.png",
        "setup_wizard_en.qm",
        "setup_wizard_fr.qm",
        "setup_wizard_ja.qm",
        "slogan.png",
        "wordmark.png",
        "//gui/base:combo_chevron.png",
        "//gui/base:tr_en.qm",
        "//gui/base:tr_fr.qm",
        "//gui/base:tr_ja.qm",
    ],
    outs = ["qrc_setup_wizard.cc"],
    qrc_file = "setup_wizard.qrc",
    qrc_name = "qrc_setup_wizard",
)

mozc_objc_library(
    name = "setup_wizard_mac",
    srcs = ["setup_wizard_mac.mm"],
    hdrs = ["setup_wizard_mac.h"],
    sdk_frameworks = ["Cocoa"],
)

mozc_cc_qt_library(
    name = "setup_wizard",
    srcs = [
        "setup_wizard.cc",
        "setup_wizard_harbour.cc",
        "setup_wizard_libmain.cc",
        "setup_wizard_mark.cc",
        "setup_wizard_style.cc",
        ":moc_setup_wizard",
        ":qrc_setup_wizard",
    ],
    hdrs = [
        "setup_wizard.h",
        "setup_wizard_harbour.h",
        "setup_wizard_mark.h",
        "setup_wizard_style.h",
        "setup_wizard_theme.h",
    ],
    local_defines = ["MARINAMOJI"],
    deps = [
        "//base:system_util",
        "//client",
        "//client:client_interface",
        "//config:config_handler",
        "//gui/base:gui_base",
        "//gui/base:singleton_window_helper",
        "//protocol:config_cc_proto",
        "@com_google_absl//absl/log",
    ] + mozc_select(
        macos = [
            ":setup_wizard_mac",
            "//base/mac:mac_util",
        ],
    ),
)

mozc_cc_qt_library(
    name = "setup_wizard_main_lib",
    srcs = ["setup_wizard_main.cc"],
    deps = [
        ":setup_wizard",
        "//base:init_mozc",
    ] + mozc_select(
        windows = [
            "//base/win32:winmain",
        ],
    ),
)

mozc_cc_qt_binary(
    name = "setup_wizard_main",
    deps = [":setup_wizard_main_lib"],
)

mozc_macos_qt_application(
    name = "setup_wizard_macos",
    bundle_name = "SetupWizard",
    deps = [":setup_wizard_main_lib"],
)
