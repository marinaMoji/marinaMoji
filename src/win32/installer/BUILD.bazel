# Build rules for the Windows installer.

load("@bazel_skylib//lib:selects.bzl", "selects")
load("//:build_defs.bzl", "mozc_py_binary")
load("//:config.bzl", "BRANDING")
load(":installer.bzl", "mozc_win_installer")

package(default_visibility = ["//visibility:private"])

mozc_py_binary(
    # Note, "build_installer" cannot be used as a name here, since "install" is a keyword that
    # Windows treats as a specific UAC behavior.
    # https://github.com/google/mozc/issues/1519
    # https://learn.microsoft.com/en-us/windows/security/application-security/application-control/user-account-control/architecture
    name = "build_msi",
    srcs = ["build_installer.py"],
    test_lib = False,
    deps = [
        "//build_tools:mozc_version_lib",
        "//build_tools:vs_util",
    ],
)

mozc_py_binary(
    name = "embed_transforms",
    srcs = ["embed_transforms.py"],
    test_lib = False,
)

exports_files([
    "installer_64bit.wxs",
    "installer_oss_64bit.wxs",
    "installer_marinamoji_64bit.wxs",
])

config_setting(
    name = "debug_build",
    values = {
        "compilation_mode": "dbg",
    },
    visibility = ["//visibility:private"],
)

_WXS_FILE = {
    "Mozc": ":installer_oss_64bit.wxs",
    "marinaMoji": ":installer_marinamoji_64bit.wxs",
}.get(BRANDING, ":installer_64bit.wxs")

# marinaMoji builds one MSI per culture, then folds them into the single
# multilingual marinaMoji64.msi that actually ships. These per-culture
# packages are intermediates -- buildable on their own for debugging, but not
# what any consumer depends on. The upstream brandings hardcode their own
# language in their .wxs and get a single unlocalized MSI.
#
# This is the one definition of the culture set. It used to be a shared
# installer_cultures.py imported by both scripts, but Bazel stages them in
# runfiles under win32/installer/ and nothing else in the tree imports a
# sibling module from a nested package, so the import had no working form to
# copy. Both scripts now take these values as flags instead.
#
# culture: (output MSI, .wxl, LCID, MSI database codepage). The codepage is
# 65001 for every culture, including ja-JP -- one string pool has to hold
# French accents and Japanese kana at once, and no ANSI codepage does.
_MSI_CULTURES = {
    "en-US": ("marinaMoji64.en-US.msi", "loc/en-us.wxl", 1033, 65001),
    "fr-FR": ("marinaMoji64.fr-FR.msi", "loc/fr-fr.wxl", 1036, 65001),
    "ja-JP": ("marinaMoji64.ja-JP.msi", "loc/ja-jp.wxl", 1041, 65001),
} if BRANDING == "marinaMoji" else {}

# The culture whose strings stay in the shipped database; the rest ride along
# as embedded language transforms.
_MSI_BASE_CULTURE = "en-US"

_MSI_FILE = {
    "Mozc": "Mozc64.msi",
}.get(BRANDING, "GoogleJapaneseInput64.msi")

selects.config_setting_group(
    name = "build_arm64_binaries",
    match_any = [
        "@platforms//cpu:arm64",
        "//:enable_win_universal_installer",
    ],
)

[
    mozc_win_installer(
        name = "installer_" + culture.lower().replace("-", "_"),
        out = info[0],
        branding = BRANDING,
        codepage = info[3],
        culture = culture,
        language = info[2],
        loc_file = info[1],
        wxs_file = _WXS_FILE,
    )
    # Starlark has no nested tuple unpacking, hence the indexing.
    for culture, info in _MSI_CULTURES.items()
]

# One unlocalized MSI for the brandings that have no per-culture build.
[
    mozc_win_installer(
        name = "installer_default",
        out = _MSI_FILE,
        branding = BRANDING,
        wxs_file = _WXS_FILE,
    )
    for _ in ([] if _MSI_CULTURES else [None])
]

# The multilingual package: the en-US database with the other cultures
# embedded as language transforms, so Windows Installer picks the language
# from the machine. This is the only MSI that ships.
[
    genrule(
        name = "installer_multilingual",
        srcs = [
            ":installer_" + culture.lower().replace("-", "_")
            for culture in _MSI_CULTURES
        ],
        outs = ["marinaMoji64.msi"],
        cmd = " ".join([
            "$(location :embed_transforms)",
            "--output=$@",
            "--base=$(location :installer_" +
            _MSI_BASE_CULTURE.lower().replace("-", "_") + ")",
            "--base_language=" + str(_MSI_CULTURES[_MSI_BASE_CULTURE][2]),
        ] + [
            "--transform=" + str(_MSI_CULTURES[culture][2]) +
            "=$(location :installer_" +
            culture.lower().replace("-", "_") + ")"
            for culture in _MSI_CULTURES
            if culture != _MSI_BASE_CULTURE
        ]),
        target_compatible_with = ["@platforms//os:windows"],
        tools = [":embed_transforms"],
    )
    for _ in ([None] if _MSI_CULTURES else [])
]

# The name every consumer depends on (//:package, CI, docs).
filegroup(
    name = "installer",
    srcs = [":installer_multilingual"] if _MSI_CULTURES else [":installer_default"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//:__subpackages__"],
)
