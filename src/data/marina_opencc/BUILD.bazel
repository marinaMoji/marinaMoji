# Curated marinaMoji OpenCC data (shin→kyū). Source CSVs live in tables/;
# regenerate marinaShin2Kyu.json and the .ocd2 files with:
#   bash regen_opencc.sh   # from marinaMozc/src/
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "opencc_data",
    srcs = [
        "marinaShin2Kyu.json",
        "marinaShin2KyuCharacters.ocd2",
        "marinaShin2KyuPhrases.ocd2",
        "marinaShin2KyuVariants.ocd2",
    ],
)
